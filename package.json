{
  "name": "chewo",
  "version": "0.1.0",
  "description": "Chewo — unified Claude Code + Codex CLI session browser, terminal workspace, and cross-agent MCP server",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:mcp && npm run ensure:stt -- --soft",
    "dev": "electron-vite dev --watch",
    "build": "npm run build:mcp && electron-vite build",
    "start": "electron-vite preview",
    "predist": "npm run ensure:stt -- --soft",
    "dist": "npm run build && electron-builder --mac",
    "dist:install": "npm run dist && node scripts/install-app.mjs",
    "predist:zip": "npm run ensure:stt -- --soft",
    "dist:zip": "npm run build && electron-builder --mac zip",
    "ensure:stt": "node scripts/ensure-sidecar.mjs",
    "build:stt": "swift build -c release --package-path packages/audio-capture",
    "build:mcp": "npm run build -w @chewo/mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "canary": "tsx scripts/canary.ts",
    "canary:chat": "tsx scripts/chat-canary.ts",
    "canary:agent": "tsx scripts/agent-canary.ts",
    "preversion": "npm run typecheck && npm test",
    "version": "node scripts/sync-version.mjs && git add packages/chewo-mcp/package.json",
    "postversion": "git push origin main --follow-tags",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@deepgram/sdk": "^5.7.0",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "lucide-react": "^1.25.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
